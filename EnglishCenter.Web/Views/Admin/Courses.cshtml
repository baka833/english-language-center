@model CoursesPageViewModel

@{
    ViewData["Title"] = "Admin Courses";
}

<section class="page-shell">
    <div class="page-header">
        <div>
            <p class="eyebrow">Academic Setup</p>
            <h1>Courses</h1>
            <p>Define the course catalog with price, description and capacity.</p>
        </div>
    </div>

    <div class="admin-grid admin-grid-two">
        <section class="panel-card accent-card">
            <div class="panel-heading">
                <h2>Create Course</h2>
            </div>
            <form method="post" asp-action="CreateCourse" class="stack-form">
                @Html.AntiForgeryToken()
                <label>
                    <span>Course Name</span>
                    <input asp-for="CreateForm.CourseName" />
                </label>
                <label>
                    <span>Description</span>
                    <textarea asp-for="CreateForm.Description" rows="4"></textarea>
                </label>
                <div class="form-split">
                    <label>
                        <span>Price</span>
                        <input asp-for="CreateForm.Price" type="number" step="0.01" />
                    </label>
                    <label>
                        <span>Total Slots</span>
                        <input asp-for="CreateForm.TotalSlots" type="number" />
                    </label>
                </div>
                <button class="btn btn-primary" type="submit">Create Course</button>
            </form>
        </section>

        <section class="panel-card">
            <div class="panel-heading">
                <h2>Course Catalog</h2>
                <span class="meta-chip">@Model.Courses.Count course(s)</span>
            </div>
            <div class="list-stack">
            @foreach (var course in Model.Courses)
            {
                <article class="item-card">
                    <div>
                        <h3>@course.CourseName</h3>
                        <p>@course.Description</p>
                        <div class="micro-meta">Price: @(course.Price?.ToString("N0") ?? "-") · Slots: @(course.TotalSlots?.ToString() ?? "-")</div>
                    </div>
                    <div class="action-stack horizontal-stack">
                        <a class="btn btn-sm btn-outline-primary" asp-action="EditCourse" asp-route-id="@course.CourseId">Edit</a>
                        <form method="post" asp-action="DeleteCourse">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@course.CourseId" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                        </form>
                    </div>
                </article>
            }
            </div>
        </section>
    </div>
</section>