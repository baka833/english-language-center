@model ClassEditPageViewModel

@{
    ViewData["Title"] = "Edit Class";
}

<section class="page-shell">
    <div class="page-header compact-header">
        <div>
            <p class="eyebrow">Class Detail</p>
            <h1>@Model.Class.ClassName</h1>
            <p>@Model.Class.CourseName · @(Model.Class.TeacherName ?? "No teacher assigned")</p>
        </div>
        <div class="action-stack horizontal-stack">
            <a class="btn btn-outline-primary" asp-action="ScheduleClass" asp-route-id="@Model.Class.ClassId">Open Schedule Planner</a>
            <a class="btn btn-outline-secondary" asp-action="Classes">Back to Classes</a>
        </div>
    </div>

    <div class="admin-grid admin-grid-two-wide">
        <section class="panel-card accent-card">
            <div class="panel-heading">
                <h2>Update Class</h2>
            </div>
            <form method="post" asp-action="UpdateClass" asp-route-id="@Model.Class.ClassId" class="stack-form">
                @Html.AntiForgeryToken()
                <label>
                    <span>Class Name</span>
                    <input asp-for="Form.ClassName" />
                </label>
                <div class="form-split">
                    <label>
                        <span>Course</span>
                        <select asp-for="Form.CourseId">
                            @foreach (var course in Model.Courses)
                            {
                                <option value="@course.Id" selected="@(course.Id == Model.Form.CourseId)">@course.Label</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span>Status</span>
                        <input asp-for="Form.Status" />
                    </label>
                </div>
                <div class="form-split">
                    <label>
                        <span>Start Date</span>
                        <input asp-for="Form.StartDate" type="date" />
                    </label>
                    <label>
                        <span>End Date</span>
                        <input asp-for="Form.EndDate" type="date" />
                    </label>
                </div>
                <label class="toggle-option standalone-toggle">
                    <input asp-for="Form.AllowTeacherGradeComponentManagement" type="checkbox" />
                    <span>Class-level grade component permission</span>
                </label>
                <button class="btn btn-primary" type="submit">Save Class</button>
            </form>
        </section>

        <section class="panel-card">
            <div class="panel-heading">
                <h2>Teacher Assignment</h2>
            </div>
            <form method="post" asp-action="AssignTeacher" asp-route-id="@Model.Class.ClassId" class="stack-form compact-form">
                @Html.AntiForgeryToken()
                <label>
                    <span>Teacher</span>
                    <select name="teacherId">
                        @foreach (var teacher in Model.Teachers)
                        {
                            <option value="@teacher.Id" selected="@(teacher.Id == Model.Class.TeacherId)">@teacher.Label (@teacher.Secondary)</option>
                        }
                    </select>
                </label>
                <button class="btn btn-primary" type="submit">Assign Teacher</button>
            </form>

            <div class="divider"></div>

            <form method="post" asp-action="ToggleClassGradePermission" asp-route-id="@Model.Class.ClassId" class="stack-form compact-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="allowTeacherGradeComponentManagement" value="@Model.Class.AllowTeacherGradeComponentManagement.ToString().ToLowerInvariant()" />
                <button class="btn btn-outline-secondary" type="submit">@(Model.Class.AllowTeacherGradeComponentManagement ? "Disable" : "Enable") Class Permission</button>
            </form>
        </section>
    </div>

    <div class="admin-grid admin-grid-two-wide">
        <section class="panel-card">
            <div class="panel-heading">
                <h2>Students</h2>
                <span class="meta-chip">@Model.Class.Students.Count assigned</span>
            </div>
            <form method="post" asp-action="AssignStudents" asp-route-id="@Model.Class.ClassId" class="stack-form compact-form">
                @Html.AntiForgeryToken()
                <div class="student-picker">
                @foreach (var student in Model.AvailableStudents)
                {
                    <label class="selection-card">
                        <input type="checkbox" name="SelectedStudentIds" value="@student.Id" />
                        <div>
                            <strong>@student.Label</strong>
                            <small>@student.Secondary · ID @student.Id</small>
                        </div>
                    </label>
                }
                </div>
                <p class="helper-copy">Select one or more students and assign them directly to this class.</p>
                <button class="btn btn-primary" type="submit">Assign Students</button>
            </form>
            <div class="table-wrap slim-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Username</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var student in Model.Class.Students)
                    {
                        <tr>
                            <td>@student.StudentId</td>
                            <td>@student.Fullname</td>
                            <td>@student.Username</td>
                            <td>
                                <form method="post" asp-action="RemoveStudent" asp-route-id="@Model.Class.ClassId">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="studentId" value="@student.StudentId" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="panel-card accent-card">
            <div class="panel-heading">
                <h2>Scheduled Sessions</h2>
            </div>
            <p class="helper-copy">Use the dedicated planner page to mark study sessions on a calendar with the fixed slot rules.</p>
            <a class="btn btn-primary" asp-action="ScheduleClass" asp-route-id="@Model.Class.ClassId">Open Planner</a>
            <div class="table-wrap slim-table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Day</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Room</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var schedule in Model.Class.Schedules.OrderBy(item => item.ScheduleDate).ThenBy(item => item.StartTime))
                    {
                        <tr>
                            <td>@schedule.ScheduleDate?.ToString("dd/MM/yyyy")</td>
                            <td>@schedule.DayOfWeek</td>
                            <td>@schedule.StartTime.ToString("HH:mm")</td>
                            <td>@schedule.EndTime.ToString("HH:mm")</td>
                            <td>@schedule.Room</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</section>