@model TeacherStudentsPageViewModel

@{
    ViewData["Title"] = "Class Students";
}

<section class="page-shell">
    <div class="page-header">
        <div>
            <p class="eyebrow">Teacher Workspace</p>
            <h1>@Model.ClassName</h1>
            <p>Student roster for your assigned class.</p>
        </div>
        <div class="action-stack">
            <a class="btn btn-outline-secondary" asp-action="Classes">Back to Classes</a>
            <a class="btn btn-outline-secondary" asp-action="Attendance" asp-route-classId="@Model.ClassId">Attendance</a>
        </div>
    </div>

    <section class="panel-card">
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Date of Birth</th>
                        <th>Enrollment</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Students.Count == 0)
                    {
                        <tr>
                            <td colspan="5">No students assigned to this class.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Students)
                        {
                            <tr>
                                <td>@item.Fullname</td>
                                <td>@item.Username</td>
                                <td>@(item.Email ?? "-")</td>
                                <td>@(item.Dob?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>@(item.EnrollmentDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>
