@model ChangePasswordViewModel
@using EnglishCenter.Web.Models.Account

@{
    ViewData["Title"] = "Change Password";
}

<section class="page-shell">
    <div class="page-header compact-header">
        <div>
            <p class="eyebrow">Account</p>
            <h1>Change Password</h1>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Profile">Back to Profile</a>
    </div>

    <section class="panel-card">
        <div class="panel-heading">
            <h2>Set a New Password</h2>
            <span class="meta-chip">Must be 8+ chars with upper, lower, digit &amp; special character</span>
        </div>
        <form method="post" asp-action="ChangePassword" class="stack-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>
            <label>
                <span>Current Password</span>
                <input asp-for="CurrentPassword" type="password" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </label>
            <label>
                <span>New Password</span>
                <input asp-for="NewPassword" type="password" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </label>
            <label>
                <span>Confirm New Password</span>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </label>
            <div class="action-stack">
                <button class="btn btn-primary" type="submit">Change Password</button>
                <a class="btn btn-outline-secondary" asp-action="Profile">Cancel</a>
            </div>
        </form>
    </section>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
