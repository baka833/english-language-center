<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EnglishCenter.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EnglishCenter.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var isAdminPage = string.Equals(currentController, "Admin", StringComparison.OrdinalIgnoreCase);
        var isTeacherPage = string.Equals(currentController, "Teacher", StringComparison.OrdinalIgnoreCase);
        var isStudentPage = string.Equals(currentController, "Student", StringComparison.OrdinalIgnoreCase);
        var displayName = User.FindFirst("full_name")?.Value ?? User.Identity?.Name ?? "Guest";
    }
    <header class="shell-header">
        <nav class="navbar navbar-expand-lg app-nav">
            <div class="container-fluid app-nav-inner">
                <a class="navbar-brand brand-lockup" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">EC</span>
                    <span>
                        <strong>English Center</strong>
                        <small>Operations Portal</small>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#appNav" aria-controls="appNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="appNav">
                    <ul class="navbar-nav ms-auto app-nav-links">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item nav-user-badge"><span class="nav-link">@displayName</span></li>
                            <li class="nav-item">
                                <form method="post" asp-controller="Account" asp-action="Logout">
                                    @Html.AntiForgeryToken()
                                    <button class="nav-link nav-button" type="submit">Sign out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="app-shell">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="flash-banner flash-success">@successMessage</div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="flash-banner flash-error">@errorMessage</div>
        }
        @if (isAdminPage || isTeacherPage || isStudentPage)
        {
            <div class="workspace-shell">
                <aside class="admin-sidebar">
                    <div class="sidebar-block">
                        <p class="eyebrow">Navigation</p>
                        @if (isAdminPage)
                        {
                            <a class="sidebar-link @(currentAction == "Users" || currentAction == "EditUser" ? "is-active" : null)" asp-area="" asp-controller="Admin" asp-action="Users">
                                <strong>Users</strong>
                                <small>Accounts, locking, reset, permissions</small>
                            </a>
                            <a class="sidebar-link @(currentAction == "Courses" || currentAction == "EditCourse" ? "is-active" : null)" asp-area="" asp-controller="Admin" asp-action="Courses">
                                <strong>Courses</strong>
                                <small>Catalog, fees, descriptions, capacity</small>
                            </a>
                            <a class="sidebar-link @(currentAction == "Classes" || currentAction == "EditClass" || currentAction == "ScheduleClass" ? "is-active" : null)" asp-area="" asp-controller="Admin" asp-action="Classes">
                                <strong>Classes</strong>
                                <small>Teacher, students, schedules, permissions</small>
                            </a>
                            <a class="sidebar-link @(currentAction == "Applications" ? "is-active" : null)" asp-area="" asp-controller="Admin" asp-action="Applications">
                                <strong>Applications</strong>
                                <small>Pending approvals and admin responses</small>
                            </a>
                        }
                        else if (isTeacherPage)
                        {
                            <a class="sidebar-link @(currentAction == "Classes" || currentAction == "Students" || currentAction == "Attendance" || currentAction == "AttendanceSummary" || currentAction == "GradeComponents" || currentAction == "Grades" ? "is-active" : null)" asp-area="" asp-controller="Teacher" asp-action="Classes">
                                <strong>Assigned Classes</strong>
                                <small>Current teaching classes and quick actions</small>
                            </a>
                            <a class="sidebar-link @(currentAction == "Schedule" ? "is-active" : null)" asp-area="" asp-controller="Teacher" asp-action="Schedule">
                                <strong>Teaching Schedule</strong>
                                <small>Monthly timetable with room and slot details</small>
                            </a>
                            <a class="sidebar-link @(currentAction == "Applications" ? "is-active" : null)" asp-area="" asp-controller="Teacher" asp-action="Applications">
                                <strong>Applications</strong>
                                <small>Leave or reschedule requests and admin feedback</small>
                            </a>
                        }
                        else
                        {
                            <a class="sidebar-link @(currentAction == "Classes" || currentAction == "ClassDetail" ? "is-active" : null)" asp-area="" asp-controller="Student" asp-action="Classes">
                                <strong>My Classes</strong>
                                <small>Enrolled classes, attendance and grades</small>
                            </a>
                            <a class="sidebar-link @(currentAction == "Schedule" ? "is-active" : null)" asp-area="" asp-controller="Student" asp-action="Schedule">
                                <strong>My Schedule</strong>
                                <small>Monthly timetable with room and slot details</small>
                            </a>
                            <a class="sidebar-link @(currentAction == "Applications" ? "is-active" : null)" asp-area="" asp-controller="Student" asp-action="Applications">
                                <strong>Applications</strong>
                                <small>Submit requests and track admin responses</small>
                            </a>
                        }
                    </div>
                </aside>
                <main role="main" class="workspace-content pb-4">
                    @RenderBody()
                </main>
            </div>
        }
        else
        {
            <main role="main" class="pb-4">
                @RenderBody()
            </main>
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
