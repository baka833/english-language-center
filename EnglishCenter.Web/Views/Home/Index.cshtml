@{
    ViewData["Title"] = "English Center Portal";
}

<section class="hero-panel">
    <div>
        <p class="eyebrow">English Center Portal</p>
        <h1>Run admin and teacher workflows from one authenticated workspace.</h1>
        <p class="hero-copy">The web client now supports role-based access with JWT-backed API calls, covering admin operations and the teacher daily workflow: assigned classes, schedule, attendance, grades and applications.</p>
        <div class="hero-actions">
            <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Login">Sign in</a>
        </div>
    </div>
    <div class="hero-metrics">
        <article>
            <span>Admin</span>
            <strong>Users, courses, classes, approvals</strong>
        </article>
        <article>
            <span>Teacher</span>
            <strong>Schedule, attendance, grades, applications</strong>
        </article>
        <article>
            <span>Security</span>
            <strong>JWT-backed API access with role checks</strong>
        </article>
    </div>
</section>
